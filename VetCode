    private JPanel createTableViewerPanel() {
        JPanel panel = new JPanel(new BorderLayout(0, 12));
        panel.setBackground(BG);
        panel.setBorder(new EmptyBorder(16, 4, 12, 4));

        JPanel topButtonPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 0));
        topButtonPanel.setOpaque(false);

        JLabel hint = new JLabel("Select a table:");
        hint.setFont(new Font(FONT_NAME, Font.BOLD, 13));
        hint.setForeground(TEXT_MUTED);
        topButtonPanel.add(hint);

        String[] tables = {"Pets", "Vet", "Appointments", "Treatments"};

        DefaultTableModel viewerModel = createReadOnlyModel();
        JTable viewerTable = new JTable(viewerModel);
        styleTable(viewerTable);
        JScrollPane viewerScroll = createTableScroll(viewerTable, "Table Contents");

        for (String tableName : tables) {
            RoundedButton btn = new RoundedButton(tableName, PRIMARY);
            btn.setPreferredSize(new Dimension(130, 34));
            btn.addActionListener(e -> {
                if (connection == null) {
                    JOptionPane.showMessageDialog(this, "Database connection not established!", "Error", JOptionPane.ERROR_MESSAGE);
                    return;
                }
                try (Statement stmt = connection.createStatement();
                     ResultSet rs = stmt.executeQuery("SELECT * FROM " + tableName)) {
                    int rows = fillModel(viewerModel, rs);
                    setStatus("Table '" + tableName + "' loaded - " + rows + " row(s)", true);
                } catch (SQLException ex) {
                    JOptionPane.showMessageDialog(this, "Error: " + ex.getMessage());
                    setStatus("Could not load table '" + tableName + "'", false);
                }
            });
            topButtonPanel.add(btn);
        }

        panel.add(topButtonPanel, BorderLayout.NORTH);
        panel.add(viewerScroll, BorderLayout.CENTER);
        return panel;
    }

