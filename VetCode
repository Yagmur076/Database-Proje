    private JPanel createCancelPanel() {
        JPanel panel = new JPanel(new BorderLayout(0, 14));
        panel.setBackground(BG);
        panel.setBorder(new EmptyBorder(16, 4, 12, 4));

        JPanel card = createCard("Cancel an Appointment", 4);

        JTextField txtApptId = createTextField(10);
        RoundedButton btnCancel = new RoundedButton("Cancel Appointment", DANGER);
        btnCancel.setPreferredSize(new Dimension(190, 34));
        RoundedButton btnRefresh = new RoundedButton("Refresh List", PRIMARY);
        btnRefresh.setPreferredSize(new Dimension(130, 34));

        addField(card, 1, 0, "Appointment ID", txtApptId);

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.gridx = 2; gbc.gridy = 1; gbc.insets = new Insets(6, 14, 6, 6);
        card.add(btnCancel, gbc);
        gbc.gridx = 3; gbc.insets = new Insets(6, 6, 6, 6);
        card.add(btnRefresh, gbc);

        JLabel note = new JLabel("Select a row below or type an ID. Related treatments will also be deleted.");
        note.setFont(new Font(FONT_NAME, Font.PLAIN, 12));
        note.setForeground(TEXT_MUTED);
        gbc = new GridBagConstraints();
        gbc.gridx = 0; gbc.gridy = 2; gbc.gridwidth = 4;
        gbc.anchor = GridBagConstraints.WEST;
        gbc.insets = new Insets(6, 6, 0, 6);
        card.add(note, gbc);

        JPanel top = new JPanel(new BorderLayout());
        top.setOpaque(false);
        top.add(card, BorderLayout.CENTER);
        panel.add(top, BorderLayout.NORTH);

        DefaultTableModel apptModel = createReadOnlyModel();
        JTable apptTable = new JTable(apptModel);
        styleTable(apptTable);
        apptTable.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        panel.add(createTableScroll(apptTable, "Existing Appointments"), BorderLayout.CENTER);

        // Satır seçilince ID alanını doldur
        apptTable.getSelectionModel().addListSelectionListener(ev -> {
            if (!ev.getValueIsAdjusting() && apptTable.getSelectedRow() >= 0) {
                Object id = apptModel.getValueAt(apptTable.getSelectedRow(), 0);
                txtApptId.setText(String.valueOf(id));
            }
        });

        Runnable refresh = () -> {
            if (connection == null) return;
            String sql = "SELECT a.appointment_id, o.owner_name, p.pet_name, v.name_surname AS vet_name, " +
                         "a.appointment_date, a.appointment_time, a.reason " +
                         "FROM Appointments a " +
                         "JOIN Pets p ON a.pet_id = p.pet_id " +
                         "JOIN Owners o ON p.owner_id = o.owner_id " +
                         "JOIN Vet v ON a.vet_id = v.vet_id " +
                         "ORDER BY a.appointment_date, a.appointment_time";
            try (Statement stmt = connection.createStatement();
                 ResultSet rs = stmt.executeQuery(sql)) {
                fillModel(apptModel, rs);
            } catch (SQLException ex) {
                setStatus("Could not load appointments: " + ex.getMessage(), false);
            }
        };
        refresh.run();
        btnRefresh.addActionListener(e -> refresh.run());

        btnCancel.addActionListener(e -> {
            if (connection == null) {
                JOptionPane.showMessageDialog(this, "Database connection not established!", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }

            String appIdStr = txtApptId.getText().trim();
            if (appIdStr.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Please enter an Appointment ID.", "Warning", JOptionPane.WARNING_MESSAGE);
                return;
            }

            int appId;
            try {
                appId = Integer.parseInt(appIdStr);
            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Appointment ID must be a valid number.", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }

            int confirm = JOptionPane.showConfirmDialog(this,
                    "Are you sure you want to cancel Appointment ID: " + appId + "?\n(This will also delete related treatments)",
                    "Confirm Cancellation",
                    JOptionPane.YES_NO_OPTION);

            if (confirm != JOptionPane.YES_OPTION) {
                return;
            }

            try {
                connection.setAutoCommit(false);

                String deleteTreatment = "DELETE FROM Treatments WHERE appointment_id = ?";
                try (PreparedStatement pstmt = connection.prepareStatement(deleteTreatment)) {
                    pstmt.setInt(1, appId);
                    pstmt.executeUpdate();
                }

                String deleteAppt = "DELETE FROM Appointments WHERE appointment_id = ?";
                int affectedRows;
                try (PreparedStatement pstmt = connection.prepareStatement(deleteAppt)) {
                    pstmt.setInt(1, appId);
                    affectedRows = pstmt.executeUpdate();
                }

                if (affectedRows > 0) {
                    connection.commit();
                    JOptionPane.showMessageDialog(this, "Appointment (ID: " + appId + ") successfully cancelled!", "Success", JOptionPane.INFORMATION_MESSAGE);
                    setStatus("Appointment #" + appId + " cancelled", true);
                    txtApptId.setText("");
                    refresh.run();
                } else {
                    connection.rollback();
                    JOptionPane.showMessageDialog(this, "Appointment ID not found in the database.", "Not Found", JOptionPane.WARNING_MESSAGE);
                }

            } catch (SQLException ex) {
                try { connection.rollback(); } catch (SQLException ignored) {}
                JOptionPane.showMessageDialog(this, "Error during cancellation:\n" + ex.getMessage(), "Database Error", JOptionPane.ERROR_MESSAGE);
                setStatus("Cancellation failed", false);
            } finally {
                try { connection.setAutoCommit(true); } catch (SQLException ignored) {}
            }
        });

        return panel;
    }

