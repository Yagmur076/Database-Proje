    private void loadTreatmentResult(int treatmentId) {
        String sql = "SELECT t.treatment_id, o.owner_name, p.pet_name, p.species, " +
                     "v.name_surname AS vet_name, a.appointment_date, a.appointment_time, t.exam_type, t.cost, t.summary " +
                     "FROM Treatments t " +
                     "JOIN Appointments a ON t.appointment_id = a.appointment_id " +
                     "JOIN Pets p ON a.pet_id = p.pet_id " +
                     "JOIN Owners o ON p.owner_id = o.owner_id " +
                     "JOIN Vet v ON a.vet_id = v.vet_id " +
                     "WHERE t.treatment_id = ?";

        try (PreparedStatement pstmt = connection.prepareStatement(sql)) {
            pstmt.setInt(1, treatmentId);
            try (ResultSet rs = pstmt.executeQuery()) {
                fillModel(tableModel, rs);
            }
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Error loading treatment: " + e.getMessage());
        }
    }

    /** ResultSet içeriğini tablo modeline yükler, satır sayısını döndürür. */
    private int fillModel(DefaultTableModel model, ResultSet rs) throws SQLException {
        model.setRowCount(0);
        model.setColumnCount(0);

        ResultSetMetaData md = rs.getMetaData();
        int cols = md.getColumnCount();
        Vector<String> colNames = new Vector<>();
        for (int i = 1; i <= cols; i++) colNames.add(md.getColumnLabel(i));
        model.setColumnIdentifiers(colNames);

        int count = 0;
        while (rs.next()) {
            Vector<Object> row = new Vector<>();
            for (int i = 1; i <= cols; i++) row.add(rs.getObject(i));
            model.addRow(row);
            count++;
        }
        return count;
    }

