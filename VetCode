    private int getNextId(String tableName, String idColumnName) {
        int maxId = 0;
        String query = "SELECT MAX(" + idColumnName + ") FROM " + tableName;
        try (Statement stmt = connection.createStatement();
             ResultSet rs = stmt.executeQuery(query)) {
            if (rs.next()) {
                maxId = rs.getInt(1);
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return maxId + 1;
    }

    /** Aynı ad+telefonlu sahip varsa onun owner_id'sini döndürür, yoksa Owners'a ekler. */
    private int findOrCreateOwner(String name, String phone) throws SQLException {
        String find = "SELECT owner_id FROM Owners WHERE owner_name = ? AND owner_phone = ? LIMIT 1";
        try (PreparedStatement ps = connection.prepareStatement(find)) {
            ps.setString(1, name);
            ps.setString(2, phone);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) return rs.getInt(1);
            }
        }
        String insert = "INSERT INTO Owners (owner_name, owner_phone) VALUES (?, ?)";
        try (PreparedStatement ps = connection.prepareStatement(insert, Statement.RETURN_GENERATED_KEYS)) {
            ps.setString(1, name);
            ps.setString(2, phone);
            ps.executeUpdate();
            try (ResultSet keys = ps.getGeneratedKeys()) {
                keys.next();
                return keys.getInt(1);
            }
        }
    }

