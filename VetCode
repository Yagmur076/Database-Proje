    private static class RoundedButton extends JButton {
        private final Color base;
        private boolean hovering = false;

        RoundedButton(String text, Color base) {
            super(text);
            this.base = base;
            setContentAreaFilled(false);
            setFocusPainted(false);
            setBorderPainted(false);
            setOpaque(false);
            setForeground(Color.WHITE);
            setFont(new Font(FONT_NAME, Font.BOLD, 13));
            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
            addMouseListener(new MouseAdapter() {
                @Override public void mouseEntered(MouseEvent e) { hovering = true; repaint(); }
                @Override public void mouseExited(MouseEvent e) { hovering = false; repaint(); }
            });
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            Color c = base;
            if (getModel().isPressed()) c = base.darker().darker();
            else if (hovering) c = base.darker();
            g2.setColor(c);
            g2.fillRoundRect(0, 0, getWidth(), getHeight(), 10, 10);
            g2.dispose();
            super.paintComponent(g);
        }
    }

    // ---- Pati ikonu (Java2D ile çizilir, tüm bilgisayarlarda aynı görünür) ----
    private static void paintPaw(Graphics2D g2, double x, double y, double size, Color color) {
        Graphics2D g = (Graphics2D) g2.create();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(color);

        // Ana ped
        g.fill(new Ellipse2D.Double(x + 0.24 * size, y + 0.50 * size, 0.52 * size, 0.42 * size));

        // Dört parmak: {sol, üst, dönme açısı}
        double[][] toes = {
                {0.03, 0.34, -30},
                {0.26, 0.07, -10},
                {0.55, 0.07, 10},
                {0.77, 0.34, 30}
        };
        double w = 0.20 * size, h = 0.29 * size;
        for (double[] t : toes) {
            double tx = x + t[0] * size, ty = y + t[1] * size;
            Graphics2D gt = (Graphics2D) g.create();
            gt.rotate(Math.toRadians(t[2]), tx + w / 2, ty + h / 2);
            gt.fill(new Ellipse2D.Double(tx, ty, w, h));
            gt.dispose();
        }
        g.dispose();
    }

    /** Pencere / görev çubuğu ikonu: koyu yuvarlak kare üstünde beyaz pati. */
    private static Image createAppIcon() {
        int s = 64;
        BufferedImage img = new BufferedImage(s, s, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g = img.createGraphics();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setPaint(new GradientPaint(0, 0, PRIMARY_DARK, s, s, ACCENT));
        g.fillRoundRect(0, 0, s, s, 18, 18);
        paintPaw(g, 12, 12, 40, Color.WHITE);
        g.dispose();
        return img;
    }

