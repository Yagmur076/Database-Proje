-- 1. Veritabanını seçelim
USE veteriner_klinigi;

-- 2. Eğer yoksa önce bağımsız olan ana tabloları (owners ve vet) oluşturalım
CREATE TABLE IF NOT EXISTS owners (
    owner_id INT NOT NULL PRIMARY KEY,
    owner_name VARCHAR(50) NOT NULL,
    owner_phone VARCHAR(20) NOT NULL
);

CREATE TABLE IF NOT EXISTS vet (
    vet_id INT NOT NULL PRIMARY KEY,
    name_surname VARCHAR(100) NOT NULL,
    specialization VARCHAR(100)
);

-- 3. Pets tablosunu oluşturalım ve owner_id ile owners tablosuna bağlayalım
CREATE TABLE IF NOT EXISTS pets (
    pet_id INT NOT NULL PRIMARY KEY,
    owner_id INT NOT NULL,
    pet_name VARCHAR(50) NOT NULL,
    species VARCHAR(50) NOT NULL,
    gender VARCHAR(10),
    is_neutered BOOLEAN,
    breed VARCHAR(50),
    birth_date DATE,
    FOREIGN KEY (owner_id) REFERENCES owners(owner_id)
);

-- 4. Appointments tablosunu oluşturalım (pet ve vet tablolarına bağlı)
CREATE TABLE IF NOT EXISTS Appointments (
    appointment_id INT NOT NULL PRIMARY KEY,
    pet_id INT NOT NULL,
    vet_id INT NOT NULL,
    appointment_date DATE NOT NULL,
    appointment_time TIME NOT NULL,
    reason VARCHAR(100) NOT NULL,
    FOREIGN KEY (pet_id) REFERENCES pets(pet_id),
    FOREIGN KEY (vet_id) REFERENCES vet(vet_id)
);

-- 5. Treatments tablosunu oluşturalım (Appointments tablosuna bağlı)
CREATE TABLE IF NOT EXISTS Treatments (
    treatment_id INT NOT NULL PRIMARY KEY,
    appointment_id INT NOT NULL,
    exam_type VARCHAR(50) NOT NULL,
    summary VARCHAR(255),
    cost DECIMAL(10,2),
    FOREIGN KEY (appointment_id) REFERENCES Appointments(appointment_id)
);
