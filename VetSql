-- 1. Veritabanını oluştur ve seç
CREATE DATABASE IF NOT EXISTS veteriner_klinigi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE veteriner_klinigi;

-- Varsa eski tabloları ilişkilerine göre temizle
DROP TABLE IF EXISTS Treatments;
DROP TABLE IF EXISTS Appointments;
DROP TABLE IF EXISTS Vet;
DROP TABLE IF EXISTS Pets;

-- 2. Veterinerler Tablosu
CREATE TABLE IF NOT EXISTS Vet (
    vet_id INT NOT NULL PRIMARY KEY,
    name_surname VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
    specialization VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
);

